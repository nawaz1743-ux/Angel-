# Copy to .env in your deployment environment. Never commit real credentials.
APP_ENV=development
ANGEL_ADS_API_KEY=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=https://YOUR-DEPLOYMENT-DOMAIN/oauth/google/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://YOUR-DEPLOYMENT-DOMAIN/oauth/meta/callback
DATABASE_URL=sqlite:///./angel_ads.db
MONITORING_ENABLED=false
